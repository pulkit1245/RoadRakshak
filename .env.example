# ──────────────────────────────────────────────
# RoadRakshak Frontend — Environment Variables
# ──────────────────────────────────────────────
# Copy this to .env and fill in your values:
#   cp .env.example .env

# Backend API base URL (no trailing slash)
VITE_API_URL=http://127.0.0.1:8000

# WebSocket URL (leave blank to auto-derive from VITE_API_URL)
# VITE_WS_URL=ws://127.0.0.1:8000/ws

# ── Ola Maps API ──────────────────────────────
# Get your key from: https://maps.olakrutrim.com/
# Used to fetch nearby hospitals when an accident is detected.
VITE_OLA_API_KEY=YOUR_OLA_API_KEY_HERE
